# NVIDIA Build (https://build.nvidia.com/) — LLM y embeddings
NVIDIA_API_KEY=

# Proveedor y modelo (solo NVIDIA por ahora)
LLM_PROVIDER=nvidia
LLM_MODEL=meta/llama-3.1-8b-instruct
EMBED_MODEL=baai/bge-m3

# Clave compartida con Nest para /upload e /ingest (opcional en local)
INTERNAL_API_KEY=dev-internal-key

# Orígenes permitidos (frontend + admin + Nest)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174

# Opcionales
# EMBED_BATCH_SIZE=32
# CHAT_SIMILARITY_TOP_K=5
# SESSION_TTL_HOURS=24
